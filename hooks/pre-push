#!/usr/bin/env bash
# hooks/pre-push
#
# Git pre-push hook — blocks the push when formatting, lints, or tests fail.
# Runs the fast validation gate:
#   scripts/validate.sh --fast
#
# Install once per clone:
#   bash scripts/install_hooks.sh
#
# Exit code: 0 = gates pass (push proceeds), 1 = gate failed (push blocked).

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPTS="$REPO_ROOT/scripts"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  pre-push: running fast validation (Rust + Python) "
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if ! bash "$SCRIPTS/validate.sh" --fast; then
    echo "❌  Pre-push validation failed — push blocked."
    exit 1
fi

echo "✅  Pre-push validation passed — push allowed."
exit 0
